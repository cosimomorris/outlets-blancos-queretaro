# Copy to .env for `netlify dev`, or set these in Netlify with Functions scope per deploy context.
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...
# Public HTTPS origin of the site. Used for Mercado Pago back_urls and notification_url.
# Locally use an ngrok https URL; Mercado Pago rejects localhost.
SITE_URL=https://outletblancosqro.com

# Gmail app password for outletblancosqro@gmail.com. Secret, Functions scope.
# Create with Google 2-Step Verification; never use your normal Gmail password.
ORDER_EMAIL_APP_PASSWORD=
# Optional: route BOTH sandbox order copies to this controlled inbox.
# Without this setting sandbox payments do not send email.
ORDER_EMAIL_TEST_TO=
