# Copy to .env for `netlify dev`, or set these in Netlify with Functions scope per deploy context.
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...
# Public HTTPS origin of the site. Used for Mercado Pago back_urls and notification_url.
# Locally use an ngrok https URL; Mercado Pago rejects localhost.
SITE_URL=https://outletblancosqro.com
